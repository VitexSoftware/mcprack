{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (or Mimir) — scraped from the OTEL Collector's metrics exporter",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TRACES",
      "label": "Tempo / Jaeger — traces exported by mcprack",
      "description": "",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "traces", "name": "Traces", "version": "" }
  ],
  "title": "mcprack — OpenTelemetry",
  "description": "MCP server calls, proxy activity, and config downloads exported by mcprack's telemetry.py. Import this, pick your Prometheus and Tempo/Jaeger datasources (mcprack itself never talks to them directly — it only exports OTLP to the Collector in front of them), and you're done. See README.md 'Observability (OpenTelemetry)' for how mcprack is configured to export the underlying data.",
  "tags": ["mcprack", "opentelemetry", "mcp"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(mcp_server_calls_total, service_name)",
        "current": { "text": "mcprack", "value": "mcprack" },
        "refresh": 2,
        "includeAll": true,
        "multi": false
      },
      {
        "name": "server_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(mcp_server_calls_total{service_name=~\"$service_name\"}, server_name)",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "MCP server calls",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Call rate (success vs error)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (result) (rate(mcp_server_calls_total{service_name=~\"$service_name\", server_name=~\"$server_name\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MCP server calls by server (rate)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (server_name, result) (rate(mcp_server_calls_total{service_name=~\"$service_name\", server_name=~\"$server_name\"}[5m]))",
          "legendFormat": "{{server_name}} — {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MCP server call duration — p50 / p95 / p99 (by server)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, server_name) (rate(mcp_server_call_duration_seconds_bucket{service_name=~\"$service_name\", server_name=~\"$server_name\"}[5m])))",
          "legendFormat": "p50 — {{server_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, server_name) (rate(mcp_server_call_duration_seconds_bucket{service_name=~\"$service_name\", server_name=~\"$server_name\"}[5m])))",
          "legendFormat": "p95 — {{server_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, server_name) (rate(mcp_server_call_duration_seconds_bucket{service_name=~\"$service_name\", server_name=~\"$server_name\"}[5m])))",
          "legendFormat": "p99 — {{server_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Config downloads & proxy activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Config downloads by client type (rate)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (client_type) (rate(config_downloads_total{service_name=~\"$service_name\"}[15m]))",
          "legendFormat": "{{client_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 40 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Total calls by server (current window)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (server_name, result) (increase(mcp_server_calls_total{service_name=~\"$service_name\", server_name=~\"$server_name\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Recent mcprack traces (mcp.server.call / vaultwarden.lookup / catalog.generate_config / mcp.proxy.*)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "tempo", "uid": "${DS_TRACES}" },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=",
              "value": ["$service_name"],
              "valueType": "string"
            }
          ],
          "limit": 50
        }
      ],
      "description": "Filtered to spans from mcprack itself. To jump to one specific request's trace from an audit log entry, use the 'View trace' link on /admin/audit-log/request/<id> instead — it's built from OTEL_TRACE_UI_URL_TEMPLATE and searches by the audit.request_id span attribute, which every custom mcprack span carries."
    }
  ]
}

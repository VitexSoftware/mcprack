# Copy to .env for local development (not used in production — the systemd
# unit reads /etc/mcprack/env via EnvironmentFile instead).

SECRET_KEY=change-me
SQLALCHEMY_DATABASE_URI=sqlite:///mcprack-dev.db

LDAP_SERVER=ldap://10.11.25.3:389
LDAP_BASE_DN=dc=spojent,dc=cz
LDAP_USER_OU=ou=Users,dc=spojent,dc=cz
LDAP_USER_FILTER=(sAMAccountName=%(user)s)

# Get BW_CLIENTID/BW_CLIENTSECRET from the Vaultwarden web vault:
# Account Settings -> Security -> Keys (API Key). BW_PASSWORD is that
# account's master password. Once set, log in as an admin and check
# /admin/vaultwarden/wizard to verify the connection step by step.
BW_SERVER=https://vaultwarden-dev.proxy.spojenet.cz
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
BITWARDENCLI_APPDATA_DIR=.bw

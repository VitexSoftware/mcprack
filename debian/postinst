#!/bin/sh
set -e

case "$1" in
  configure)
    # Create mcprack system user if it doesn't exist (www-data is used for main app)
    if ! getent passwd mcprack > /dev/null; then
      adduser --system --group --home /var/lib/mcprack --no-create-home \
        --disabled-login --quiet mcprack
    fi

    install -d -o www-data -g www-data -m 0750 /var/lib/mcprack
    # Also ensure mcprack user can read the proxy config
    chown -R mcprack:mcprack /var/lib/mcprack || true

    if [ -f /etc/mcprack/env ]; then
      set -a
      # shellcheck disable=SC1091
      . /etc/mcprack/env
      set +a
      su -s /bin/sh www-data -c \
        'cd /usr/lib/mcprack && FLASK_APP=app:create_app flask db upgrade' \
        || echo "mcprack: 'flask db upgrade' failed - check /etc/mcprack/env and run it manually." >&2
    else
      echo "mcprack: /etc/mcprack/env not found yet - create it (see /usr/share/doc/mcprack/README.Debian), then run:"
      echo "  su -s /bin/sh www-data -c 'cd /usr/lib/mcprack && FLASK_APP=app:create_app flask db upgrade'"
    fi

    # Reload systemd daemon for mcprack-proxy.service
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      echo "mcprack: systemd service files installed. To enable the MCP HTTP proxy:"
      echo "  systemctl enable --now mcprack-proxy.service"
    fi
    ;;
esac

#DEBHELPER#

exit 0

#!/bin/sh
set -e

case "$1" in
  configure)
    # Install systemd service files from /usr/lib/mcprack
    install -d -m 0755 /lib/systemd/system
    install -m 0644 /usr/lib/mcprack/mcprack.service /lib/systemd/system/
    install -m 0644 /usr/lib/mcprack/mcprack-proxy.service /lib/systemd/system/
    
    # Create mcprack system user if it doesn't exist
    if ! getent passwd mcprack > /dev/null; then
      adduser --system --group --home /var/lib/mcprack --no-create-home \
        --disabled-login --quiet mcprack
    fi

    # MCprack application and data directory (owned by mcprack user)
    install -d -o mcprack -g mcprack -m 0750 /var/lib/mcprack
    install -d -o root -g root -m 0755 /etc/mcprack
    install -d -o mcprack -g mcprack -m 0755 /var/log/mcprack

    # Check if stdin is a terminal (interactive mode)
    if [ -t 0 ]; then
      INTERACTIVE=true
    else
      INTERACTIVE=false
    fi

    # Configuration if /etc/mcprack/env doesn't exist
    if [ ! -f /etc/mcprack/env ]; then
      if [ "$INTERACTIVE" = "true" ]; then
        # Interactive configuration
        echo ""
        echo "========================================="
        echo "MCprack Configuration"
        echo "========================================="
        echo ""
        
        SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))" 2>/dev/null || echo "change-me-$(date +%s)")
        
        printf "Vaultwarden server URL [https://vaultwarden.proxy.spojenet.cz]: "
        read -r BW_SERVER
        BW_SERVER="${BW_SERVER:-https://vaultwarden.proxy.spojenet.cz}"
        
        printf "Bitwarden client ID: "
        read -r BW_CLIENTID
        
        printf "Bitwarden client secret: "
        read -r BW_CLIENTSECRET
        
        printf "Bitwarden master password: "
        read -r BW_PASSWORD
        
        printf "Enable LDAP? (y/N): "
        read -r ENABLE_LDAP
        
        if [ "$ENABLE_LDAP" = "y" ] || [ "$ENABLE_LDAP" = "Y" ]; then
          printf "LDAP server [ldap://10.11.25.3:389]: "
          read -r LDAP_SERVER
          LDAP_SERVER="${LDAP_SERVER:-ldap://10.11.25.3:389}"
          
          printf "LDAP base DN [dc=spojent,dc=cz]: "
          read -r LDAP_BASE_DN
          LDAP_BASE_DN="${LDAP_BASE_DN:-dc=spojent,dc=cz}"
          
          printf "LDAP bind DN (anonymous if empty): "
          read -r LDAP_BIND_DN
        else
          LDAP_SERVER="ldap://localhost"
          LDAP_BASE_DN="dc=example,dc=com"
          LDAP_BIND_DN=""
        fi
      else
        # Non-interactive - use defaults
        SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))" 2>/dev/null || echo "change-me-$(date +%s)")
        BW_SERVER="https://vaultwarden.proxy.spojenet.cz"
        BW_CLIENTID=""
        BW_CLIENTSECRET=""
        BW_PASSWORD=""
        LDAP_SERVER="ldap://localhost"
        LDAP_BASE_DN="dc=example,dc=com"
        LDAP_BIND_DN=""
      fi

      # Create /etc/mcprack/env
      cat > /etc/mcprack/env <<-ENV_FILE
# MCprack Configuration
# Generated: $(date)
# ⚠️  UPDATE with your actual credentials!

SECRET_KEY=$SECRET_KEY
SQLALCHEMY_DATABASE_URI=sqlite:////var/lib/mcprack/mcprack.db

LDAP_SERVER=$LDAP_SERVER
LDAP_BASE_DN=$LDAP_BASE_DN
LDAP_USER_OU=ou=Users,$LDAP_BASE_DN
LDAP_USER_FILTER='(sAMAccountName=%(user)s)'
LDAP_BIND_DN=$LDAP_BIND_DN
LDAP_BIND_PASSWORD=

BW_SERVER=$BW_SERVER
BW_CLIENTID=$BW_CLIENTID
BW_CLIENTSECRET=$BW_CLIENTSECRET
BW_PASSWORD=$BW_PASSWORD
BW_ITEM_PREFIX=MCP-
BITWARDENCLI_APPDATA_DIR=/var/lib/mcprack/.bw
BW_BIN=/usr/bin/bw
ENV_FILE
      
      chmod 0600 /etc/mcprack/env
      chown root:mcprack /etc/mcprack/env
    fi

    # Reload systemd
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi

    if [ "$INTERACTIVE" = "false" ]; then
      echo "ℹ️  mcprack installed with default configuration"
      echo "⚠️  Update /etc/mcprack/env with your Vaultwarden credentials"
      exit 0
    fi
    ;;
esac

#DEBHELPER#

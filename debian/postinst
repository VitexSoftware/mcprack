#!/bin/sh
set -e

# Quote a value for /etc/mcprack/env. The file is read by systemd (EnvironmentFile=)
# AND sourced as shell code by this script and bin/mcprack, so a value with a
# space, '$', a quote or '#' (a password!) must not be left bare.
shq() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Read a secret without echoing it to the terminal.
read_secret() {
  _prompt="$1"
  printf "%s (input hidden): " "$_prompt" >&2
  stty -echo 2>/dev/null || true
  read -r _secret || true
  stty echo 2>/dev/null || true
  echo "" >&2
  printf '%s' "$_secret"
}

case "$1" in
  configure)
    # Install systemd service files from /usr/lib/mcprack
    install -d -m 0755 /lib/systemd/system
    install -m 0644 /usr/lib/mcprack/mcprack.service /lib/systemd/system/

    # Create mcprack system user if it doesn't exist
    if ! getent passwd mcprack > /dev/null; then
      adduser --system --group --home /var/lib/mcprack --no-create-home \
        --disabled-login --quiet mcprack
    fi

    # MCprack application and data directory (owned by mcprack user)
    install -d -o mcprack -g mcprack -m 0750 /var/lib/mcprack
    install -d -o root -g root -m 0755 /etc/mcprack
    install -d -o mcprack -g mcprack -m 0755 /var/log/mcprack

    # Check if stdin is a terminal (interactive mode)
    if [ -t 0 ]; then
      INTERACTIVE=true
    else
      INTERACTIVE=false
    fi

    # Ask dbconfig-common for the database engine/connection details (or, on
    # upgrades, let it reconcile its own bookkeeping) and translate the
    # result into a SQLALCHEMY_DATABASE_URI. Keeps the sqlite default at the
    # same path pre-dbconfig-common installs already used.
    dbc_dbtypes="sqlite3, pgsql, mysql"
    # Keep the sqlite3 database file under the same directory (and with the
    # same ownership) mcprack's own postinst has always used.
    dbc_basepath=/var/lib/mcprack
    dbc_dbfile_owner=mcprack:mcprack
    dbc_dbfile_perms=0640

    if [ -f /usr/share/debconf/confmodule ]; then
      . /usr/share/debconf/confmodule
    fi

    if [ -f /usr/share/dbconfig-common/dpkg/postinst ]; then
      . /usr/share/dbconfig-common/dpkg/postinst
      dbc_go mcprack "$@"
    fi

    case "$dbc_dbtype" in
      pgsql)
        DB_URI="postgresql+psycopg2://${dbc_dbuser}:${dbc_dbpass}@${dbc_dbserver}:${dbc_dbport:-5432}/${dbc_dbname}"
        ;;
      mysql)
        DB_URI="mysql+pymysql://${dbc_dbuser}:${dbc_dbpass}@${dbc_dbserver}:${dbc_dbport:-3306}/${dbc_dbname}"
        ;;
      sqlite3|*)
        DB_URI="sqlite:///${dbc_basepath:-/var/lib/mcprack}/${dbc_dbname:-mcprack}"
        ;;
    esac

    # Configuration if /etc/mcprack/env doesn't exist
    if [ ! -f /etc/mcprack/env ]; then
      PUBLIC_BASE_URL=""
      GUNICORN_BIND="127.0.0.1:8912"
      OAUTH_ENABLED="false"
      SESSION_COOKIE_SECURE="true"
      if command -v db_get >/dev/null 2>&1; then
        db_get mcprack/public_base_url
        PUBLIC_BASE_URL=$RET
        db_get mcprack/gunicorn_bind
        GUNICORN_BIND=$RET
        db_get mcprack/oauth_enabled
        OAUTH_ENABLED=$RET
        db_get mcprack/session_cookie_secure
        SESSION_COOKIE_SECURE=$RET
      fi

      if [ "$INTERACTIVE" = "true" ]; then
        # Interactive configuration
        echo ""
        echo "========================================="
        echo "MCprack Configuration"
        echo "========================================="
        echo ""
        
        SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))" 2>/dev/null || od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
        
        printf "Vaultwarden server URL [https://vaultwarden.proxy.spojenet.cz]: "
        read -r BW_SERVER
        BW_SERVER="${BW_SERVER:-https://vaultwarden.proxy.spojenet.cz}"
        
        printf "Bitwarden client ID: "
        read -r BW_CLIENTID
        
        BW_CLIENTSECRET=$(read_secret "Bitwarden client secret")
        
        BW_PASSWORD=$(read_secret "Bitwarden master password")
        
        printf "Enable LDAP? (y/N): "
        read -r ENABLE_LDAP
        
        if [ "$ENABLE_LDAP" = "y" ] || [ "$ENABLE_LDAP" = "Y" ]; then
          printf "LDAP server [ldap://10.11.25.3:389]: "
          read -r LDAP_SERVER
          LDAP_SERVER="${LDAP_SERVER:-ldap://10.11.25.3:389}"
          
          printf "LDAP base DN [dc=spojent,dc=cz]: "
          read -r LDAP_BASE_DN
          LDAP_BASE_DN="${LDAP_BASE_DN:-dc=spojent,dc=cz}"
          
          printf "LDAP bind DN (anonymous if empty): "
          read -r LDAP_BIND_DN
        else
          LDAP_SERVER="ldap://localhost"
          LDAP_BASE_DN="dc=example,dc=com"
          LDAP_BIND_DN=""
        fi
      else
        # Non-interactive - use defaults
        SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))" 2>/dev/null || od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
        BW_SERVER="https://vaultwarden.proxy.spojenet.cz"
        BW_CLIENTID=""
        BW_CLIENTSECRET=""
        BW_PASSWORD=""
        LDAP_SERVER="ldap://localhost"
        LDAP_BASE_DN="dc=example,dc=com"
        LDAP_BIND_DN=""
      fi

      # Create /etc/mcprack/env
      cat > /etc/mcprack/env <<-ENV_FILE
# MCprack Configuration
# Generated: $(date)
# ⚠️  UPDATE with your actual credentials!

SECRET_KEY=$SECRET_KEY
SQLALCHEMY_DATABASE_URI=$(shq "$DB_URI")
PUBLIC_BASE_URL=$(shq "$PUBLIC_BASE_URL")
GUNICORN_BIND=$(shq "$GUNICORN_BIND")
OAUTH_ENABLED=$(shq "$OAUTH_ENABLED")
SESSION_COOKIE_SECURE=$(shq "$SESSION_COOKIE_SECURE")

LDAP_SERVER=$(shq "$LDAP_SERVER")
LDAP_BASE_DN=$(shq "$LDAP_BASE_DN")
LDAP_USER_OU=$(shq "ou=Users,$LDAP_BASE_DN")
LDAP_USER_FILTER='(sAMAccountName=%(user)s)'
LDAP_BIND_DN=$(shq "$LDAP_BIND_DN")
LDAP_BIND_PASSWORD=
# Prefer ldaps:// in LDAP_SERVER, or keep ldap:// and set LDAP_STARTTLS=true
# (the directory certificate is verified; LDAP_CA_FILE = CA bundle).
#LDAP_STARTTLS=true
#LDAP_REQUIRED_GROUP=CN=mcprack-users,OU=Groups,$LDAP_BASE_DN

BW_SERVER=$(shq "$BW_SERVER")
BW_CLIENTID=$(shq "$BW_CLIENTID")
BW_CLIENTSECRET=$(shq "$BW_CLIENTSECRET")
BW_PASSWORD=$(shq "$BW_PASSWORD")
BW_ITEM_PREFIX=MCP-
BITWARDENCLI_APPDATA_DIR=/var/lib/mcprack/.bw
BW_BIN=/usr/bin/bw

# --- Internet-facing deployment (see /usr/share/doc/mcprack/README.Debian) ---
# Public URL of this instance. Set it as soon as mcprack is reachable from
# outside: password-reset links and OAuth metadata are built from it, and the
# application then refuses requests for any other Host.
#PUBLIC_BASE_URL=https://mcprack.example.com
# MCP proxy URLs (the secret in every generated client config) expire after
# 90 days. Fresh installs only; remove the line for no expiry.
PROXY_TOKEN_MAX_AGE_SECONDS=7776000
ENV_FILE
      
    fi

    # Fix up permissions unconditionally, not just on first creation above --
    # upgrades from packages built before 0.2.13 left /etc/mcprack/env
    # chmod 0600 (owner-only), which the mcprack system user can't read
    # despite the root:mcprack chown, breaking the migration/create-admin
    # steps below on every subsequent upgrade too.
    chmod 0640 /etc/mcprack/env
    chown root:mcprack /etc/mcprack/env

    # Reload systemd
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi

    # Verify SECRET_KEY is present and valid
    if ! grep -q "^SECRET_KEY=" /etc/mcprack/env 2>/dev/null || grep "^SECRET_KEY=dev-insecure" /etc/mcprack/env >/dev/null 2>&1; then
      echo ""
      echo "⚠️  WARNING: SECRET_KEY is not properly configured in /etc/mcprack/env" >&2
      echo ""
      echo "🔧 To fix this, run as root:" >&2
      echo "     mcprack-init-config" >&2
      echo ""
      echo "   Or manually generate and set the key:" >&2
      echo "     SECRET_KEY=\$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')" >&2
      echo "     echo \"SECRET_KEY=\$SECRET_KEY\" | sudo tee -a /etc/mcprack/env" >&2
      echo ""
    fi

    # Run Alembic migrations against whatever SQLALCHEMY_DATABASE_URI ends
    # up in /etc/mcprack/env (freshly written above, or left untouched on an
    # upgrade). db.create_all() at app startup remains a harmless additional
    # safety net, but this is what actually applies migrations/versions/.
    if ! su -s /bin/sh mcprack -c "cd /usr/lib/mcprack && set -a; . /etc/mcprack/env; set +a; FLASK_APP=mcprack.app:create_app python3 -m flask db upgrade" 2>/dev/null; then
      echo "⚠️  Database migration failed — check /etc/mcprack/env and run manually:" >&2
      echo "     su - mcprack -s /bin/sh" >&2
      echo "     cd /usr/lib/mcprack && source /etc/mcprack/env && flask db upgrade" >&2
    fi

    # Create the initial admin account if no admin exists yet (covers fresh
    # installs; leaves LDAP-provisioned or differently-named admins alone).
    ADMIN_EXISTS=$(su -s /bin/sh mcprack -c "cd /usr/lib/mcprack && set -a; . /etc/mcprack/env; set +a; FLASK_APP=mcprack.app:create_app python3 -c '
from mcprack.app import create_app
from mcprack.models import User
app = create_app()
with app.app_context():
    print(1 if User.query.filter_by(is_admin=True).first() else 0)
'" 2>/dev/null || echo 0)

    if [ "$ADMIN_EXISTS" != "1" ]; then
      ADMIN_PASS=$(python3 -c "import secrets; print(secrets.token_urlsafe(16))")
      # The password goes to the command through a file, not through its
      # argument list (visible in ps). The file lives in a directory that only
      # ROOT can modify (/run, mode 0711: the service user may traverse it but
      # cannot list it or swap anything in it), is written while still
      # root-only, and handed to the service user (chown) last - root never
      # does path operations in a directory the service user controls.
      ADMIN_PASS_DIR=$(mktemp -d /run/mcprack-admin.XXXXXX)
      ADMIN_PASS_FILE="$ADMIN_PASS_DIR/password"
      ( umask 077; printf '%s\n' "$ADMIN_PASS" > "$ADMIN_PASS_FILE" )
      chmod 0711 "$ADMIN_PASS_DIR"
      chown mcprack:mcprack "$ADMIN_PASS_FILE"
      if su -s /bin/sh mcprack -c "cd /usr/lib/mcprack && set -a; . /etc/mcprack/env; set +a; FLASK_APP=mcprack.app:create_app python3 -m flask create-admin --username admin --password-file '$ADMIN_PASS_FILE' --email ''" 2>/dev/null; then
        rm -rf "$ADMIN_PASS_DIR"
        install -m 0600 -o root -g root /dev/null /etc/mcprack/admin-credentials
        printf 'username=admin\npassword=%s\n' "$ADMIN_PASS" > /etc/mcprack/admin-credentials
        echo "✅ Initial admin account created (username: admin). Credentials saved to /etc/mcprack/admin-credentials"
        echo "   Administrators must set up two-factor authentication (an authenticator app) at their first sign-in."
        echo "   Locked out later? 'mcprack user mfa-reset admin' on this server switches it off again."
      else
        rm -rf "$ADMIN_PASS_DIR"
        echo "ℹ️  Admin account setup deferred (likely missing SECRET_KEY). Run after 'mcprack-init-config':" >&2
        echo "     su - mcprack -s /bin/sh" >&2
        echo "     cd /usr/lib/mcprack && source /etc/mcprack/env && flask create-admin" >&2
      fi
    fi

    if [ "$INTERACTIVE" = "false" ]; then
      echo ""
      echo "ℹ️  mcprack installed with default configuration"
      echo "🔧 Next steps:"
      echo "   1. Initialize configuration: sudo mcprack-init-config"
      echo "   2. Update /etc/mcprack/env with your credentials (if needed)"
      echo "   3. Start service: sudo systemctl start mcprack"
      echo "   4. Check status: sudo systemctl status mcprack"
      echo ""
    fi
    ;;
esac

#DEBHELPER#

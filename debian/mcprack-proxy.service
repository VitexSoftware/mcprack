[Unit]
Description=mcprack MCP HTTP proxy (fastmcp)
Documentation=https://gofastmcp.com
After=network.target mcprack.service
Wants=mcprack.service

[Service]
Type=simple
User=mcprack
Group=mcprack
WorkingDirectory=/var/lib/mcprack
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/mcprack/proxy.env

# Generate proxy config from mcprack catalog and run fastmcp
ExecStartPre=/usr/bin/mcprack-generate-proxy-config
ExecStart=/usr/bin/fastmcp run /var/lib/mcprack/proxy-mcp.json --transport http --host 0.0.0.0 --port 3100 --log-level INFO

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcprack-proxy

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mcprack
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

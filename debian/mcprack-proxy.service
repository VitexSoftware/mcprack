[Unit]
Description=mcprack MCP HTTP proxy (fastmcp)
Documentation=https://gofastmcp.com
After=network.target mcprack.service
Wants=mcprack.service

[Service]
Type=simple
User=mcprack
Group=mcprack
WorkingDirectory=/var/lib/mcprack
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/mcprack/env
EnvironmentFile=-/etc/mcprack/proxy.env

# Generate proxy config from mcprack catalog
ExecStartPre=/usr/bin/mcprack-generate-proxy-config

# Run fastmcp proxy with host/port from /etc/mcprack/proxy.env
ExecStart=/usr/bin/mcprack-proxy-start

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcprack-proxy

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mcprack
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

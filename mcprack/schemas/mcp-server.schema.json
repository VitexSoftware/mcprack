{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/VitexSoftware/mcprack/blob/main/mcprack/schemas/mcp-server.schema.json",
  "title": "VitexSoftware MCP server manifest (server.json)",
  "description": "The single metadata file of an MCP server. It is a valid MCP Registry server.json (https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json, publishable with mcp-publisher) that additionally REQUIRES the fields mcprack needs, and carries the VitexSoftware extension block in _meta -> io.modelcontextprotocol.registry/publisher-provided -> cz.vitexsoftware.mcp. It replaces lhm.plugin.json.",
  "type": "object",
  "required": ["name", "title", "description", "version", "repository", "packages", "_meta"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {
      "description": "Registry name: reverse-DNS namespace, one slash, then the server name. Not the identity of the server kind - that is the uuid - so it may be changed by a rename.",
      "type": "string", "minLength": 3, "maxLength": 200,
      "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$"
    },
    "title": {"description": "Human readable name.", "type": "string", "minLength": 1, "maxLength": 100},
    "description": {"description": "One sentence (the Registry allows at most 100 characters). Longer text goes to cz.vitexsoftware.mcp.longDescription.", "type": "string", "minLength": 1, "maxLength": 100},
    "version": {"description": "Exact released version, no ranges.", "type": "string", "minLength": 1, "maxLength": 255, "not": {"const": "latest"}},
    "websiteUrl": {"type": "string", "format": "uri", "pattern": "^https?://\\S+$"},
    "repository": {
      "type": "object",
      "required": ["url", "source"],
      "properties": {
        "url": {"description": "The GitHub (or Forgejo) project.", "type": "string", "format": "uri", "pattern": "^https?://\\S+$"},
        "source": {"type": "string", "minLength": 1},
        "id": {"type": "string"},
        "subfolder": {"type": "string"}
      }
    },
    "icons": {"type": "array", "items": {"type": "object", "required": ["src"], "properties": {"src": {"type": "string", "maxLength": 255}}}},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["registryType", "identifier", "transport"],
        "properties": {
          "registryType": {"type": "string", "minLength": 1},
          "identifier": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "transport": {
            "type": "object",
            "required": ["type"],
            "properties": {"type": {"enum": ["stdio", "streamable-http", "sse"]}}
          },
          "environmentVariables": {
            "description": "Every environment variable the server reads - the parameters shown on the server page and pre-filled into mcprack's admin form.",
            "type": "array",
            "items": {"$ref": "#/definitions/EnvironmentVariable"}
          }
        }
      }
    },
    "remotes": {"type": "array"},
    "_meta": {
      "type": "object",
      "required": ["io.modelcontextprotocol.registry/publisher-provided"],
      "properties": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "type": "object",
          "required": ["cz.vitexsoftware.mcp"],
          "properties": {"cz.vitexsoftware.mcp": {"$ref": "#/definitions/VitexExtension"}}
        }
      }
    }
  },
  "definitions": {
    "EnvironmentVariable": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"description": "Exact name, case included.", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "isRequired": {"description": "Only for values without which the server cannot start.", "type": "boolean"},
        "isSecret": {"description": "True for credentials; a default is then never pre-filled.", "type": "boolean"},
        "default": {"type": "string"},
        "choices": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "format": {"enum": ["string", "number", "boolean", "filepath"]},
        "placeholder": {"type": "string"}
      },
      "if": {"properties": {"isSecret": {"const": true}}, "required": ["isSecret"]},
      "then": {"not": {"required": ["default"]}}
    },
    "NamedItem": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "Tool": {
      "allOf": [{"$ref": "#/definitions/NamedItem"}],
      "properties": {
        "title": {"type": "string"},
        "annotations": {
          "description": "The four MCP hints, as in MCP-SERVER-STANDARDS.md section 1.",
          "type": "object",
          "properties": {
            "readOnlyHint": {"type": "boolean"},
            "destructiveHint": {"type": "boolean"},
            "idempotentHint": {"type": "boolean"},
            "openWorldHint": {"type": "boolean"}
          }
        },
        "inputSchema": {"type": "object"}
      }
    },
    "VitexExtension": {
      "type": "object",
      "required": ["uuid", "author", "tools"],
      "properties": {
        "uuid": {
          "description": "Identity of this KIND of server. Generated once, committed, never changed or reused - not by a rename, a re-packaging, a fork that continues the project or a move to another repository.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "url": {"type": "string", "pattern": "^https?://\\S+$"}
          }
        },
        "longDescription": {"description": "Paragraphs shown on the server page; a list item is a nested array of strings.", "type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
        "category": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "tools": {"description": "Every tool the server registers.", "type": "array", "items": {"$ref": "#/definitions/Tool"}},
        "prompts": {"type": "array", "items": {"$ref": "#/definitions/NamedItem"}},
        "resources": {"type": "array", "items": {"$ref": "#/definitions/NamedItem"}}
      }
    }
  }
}

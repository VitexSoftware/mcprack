msgstr "Povoleno — trasování a metriky se exportují."

#: mcprack/templates/admin/otel_wizard.html:18
msgid ""
"Disabled (no-op) — set <code>OTEL_ENABLED=true</code> in "
"<code>/etc/mcprack/env</code> and restart the service to turn this on."
msgstr ""
"Zakázáno (bez efektu) — nastavte <code>OTEL_ENABLED=true</code> v "
"<code>/etc/mcprack/env</code> a restartujte službu pro zapnutí."


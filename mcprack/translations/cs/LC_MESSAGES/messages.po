"Always stored as a secret — the administrator declared this key, or its "
"name looks like a credential."
msgstr ""
"Vždy se ukládá jako tajná hodnota — tento klíč deklaroval administrátor, "
"nebo jeho název vypadá jako přihlašovací údaj."

#: mcprack/templates/_override_editor.html:82
msgid "Inherited from admin"
msgstr "Zděděno od administrátora"

#: mcprack/templates/_override_editor.html:83
msgid "Overridden"
msgstr "Přetíženo"

#: mcprack/templates/_override_editor.html:84
msgid "Custom"
msgstr "Vlastní"

#: mcprack/templates/_override_editor.html:85
msgid "↺ Revert to admin default"
msgstr "↺ Vrátit na výchozí od administrátora"

#: mcprack/templates/_override_editor.html:86
msgid "Duplicate key — each variable name must be unique."
msgstr "Duplicitní klíč — každý název proměnné musí být jedinečný."

#: mcprack/templates/_override_editor.html:87
#: mcprack/templates/admin/install_wizard.html:66
#: mcprack/templates/admin/install_wizard.html:103
#: mcprack/templates/admin/install_wizard.html:137
#: mcprack/templates/admin/server_form.html:178

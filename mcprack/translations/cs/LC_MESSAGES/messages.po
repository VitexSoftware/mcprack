#: mcprack/admin.py:211
msgid "This access request has already been resolved."
msgstr "Tato žádost o přístup již byla vyřízena."

#: mcprack/admin.py:216
msgid "Enable the account and server before granting access."
msgstr "Před udělením přístupu aktivujte účet a server."

#: mcprack/admin.py:238
msgid "Access request updated."
msgstr "Žádost o přístup byla aktualizována."

#: mcprack/app.py:247
msgid "Bad Request"
msgstr "Neplatný požadavek"

#: mcprack/app.py:248
msgid "The request could not be understood by the server."
msgstr "Serveru se nepodařilo požadavku porozumět."

#: mcprack/app.py:260
msgid "Access Denied"
msgstr "Přístup odepřen"

#: mcprack/app.py:261
msgid "You do not have permission to access this resource."
msgstr "K tomuto zdroji nemáte oprávnění."

#: mcprack/app.py:273
msgid "Page Not Found"
msgstr "Stránka nenalezena"

#: mcprack/app.py:274
msgid "The page or resource you requested could not be found."
msgstr "Požadovaná stránka ani zdroj nebyly nalezeny."

#: mcprack/app.py:286
msgid "Request Too Large"
msgstr "Požadavek je příliš velký"

#: mcprack/app.py:287
msgid "The data you submitted is larger than this server accepts."
msgstr "Odeslaná data jsou větší, než tento server přijímá."

#: mcprack/app.py:300
msgid "Too Many Requests"
msgstr "Příliš mnoho požadavků"

#: mcprack/app.py:301
msgid ""
"Too many requests from your IP address. Please slow down and try again "
"later."
msgstr ""
"Z vaší IP adresy přišlo příliš mnoho požadavků. Zpomalte a zkuste to "
"znovu později."

#: mcprack/app.py:315
msgid "Internal Server Error"
msgstr "Vnitřní chyba serveru"

#: mcprack/app.py:316
msgid "An unexpected server error occurred. Please contact the administrator."
msgstr "Došlo k neočekávané chybě serveru. Obraťte se na administrátora."

#: mcprack/app.py:328
msgid "Bad Gateway"
msgstr "Chybná brána"

#: mcprack/app.py:329
msgid "The upstream service did not respond properly."
msgstr "Nadřazená služba neodpověděla správně."

#: mcprack/auth.py:148
msgid ""
"Administrators must set up two-factor authentication before using the "
"admin area."
msgstr "Správci musí před použitím administrace nastavit dvoufázové ověření."

#: mcprack/auth.py:287
msgid "Your sign-in expired. Please enter your password again."
msgstr "Platnost přihlášení vypršela. Zadejte prosím znovu své heslo."

#: mcprack/auth.py:295 mcprack/auth.py:338 mcprack/auth.py:515
#: mcprack/auth.py:548 mcprack/auth.py:584
msgid "Too many failed attempts. Try again in a few minutes."
msgstr "Příliš mnoho neúspěšných pokusů. Zkuste to znovu za několik minut."

#: mcprack/auth.py:308
#, python-format
msgid ""
"You signed in with a recovery code. %(count)d left - consider generating "
"new ones."
msgstr ""
"Přihlásili jste se záložním kódem. Zbývá jich %(count)d – zvažte "
"vytvoření nových."

#: mcprack/auth.py:314
msgid "That code is not valid."
msgstr "Tento kód není platný."

#: mcprack/auth.py:354 mcprack/auth.py:384
msgid "Invalid username or password."
msgstr "Neplatné uživatelské jméno nebo heslo."

#: mcprack/auth.py:374
msgid "This account has been deactivated."
msgstr "Tento účet byl deaktivován."

#: mcprack/auth.py:437
msgid ""
"Your account is managed externally (LDAP) — its password can't be changed"
" here."
msgstr "Váš účet je spravován externě (LDAP) — jeho heslo zde nelze změnit."

#: mcprack/auth.py:446
msgid "Current password is incorrect."
msgstr "Aktuální heslo je nesprávné."

#: mcprack/auth.py:448 mcprack/auth.py:661
msgid "New password and confirmation don't match."
msgstr "Nové heslo a jeho potvrzení se neshodují."

#: mcprack/auth.py:458
msgid "Password changed."
msgstr "Heslo bylo změněno."

#: mcprack/auth.py:478
msgid "QR code for your authenticator app"
msgstr "QR kód pro vaši autentizační aplikaci"

#: mcprack/auth.py:479
msgid "Scan it with an authenticator app to add this account."
msgstr "Naskenujte jej autentizační aplikací a přidejte tento účet."

#: mcprack/auth.py:506
msgid ""
"Two-factor authentication is already on. Turn it off first to set it up "
"again."
msgstr ""
"Dvoufázové ověření je už zapnuté. Chcete-li je nastavit znovu, nejprve je"
" vypněte."

#: mcprack/auth.py:519
msgid "Your password is not correct."
msgstr "Vaše heslo není správné."

#: mcprack/auth.py:529
msgid "That code is not valid. Check the time on your phone and try again."
msgstr "Tento kód není platný. Zkontrolujte čas v telefonu a zkuste to znovu."

#: mcprack/auth.py:539
msgid "Two-factor authentication is not on."
msgstr "Dvoufázové ověření není zapnuté."

#: mcprack/auth.py:543
msgid "Administrators cannot turn two-factor authentication off."
msgstr "Správci nemohou dvoufázové ověření vypnout."

#: mcprack/auth.py:554 mcprack/auth.py:594
msgid "Your password or the code is not correct."
msgstr "Vaše heslo nebo kód není správný."

#: mcprack/auth.py:565
msgid "Two-factor authentication is now off."
msgstr "Dvoufázové ověření je nyní vypnuté."

#: mcprack/auth.py:568
msgid "Unknown action."
msgstr "Neznámá akce."

#: mcprack/auth.py:626
msgid "mcprack password reset"
msgstr "Obnovení hesla pro mcprack"

#: mcprack/auth.py:628
#, python-format
msgid ""
"Someone (hopefully you) requested a password reset for the mcprack "
"account '%(username)s'.\n"
"\n"
"Reset it here (valid for %(minutes)d minutes):\n"
"%(url)s\n"
"\n"
"If you didn't request this, ignore this email — your password hasn't been"
" changed."
msgstr ""
"Někdo (doufejme, že vy) požádal o obnovení hesla pro účet mcprack "
"„%(username)s“.\n"
"\n"
"Obnovte ho zde (platí %(minutes)d minut):\n"
"%(url)s\n"
"\n"
"Pokud jste o to nežádali, tento e-mail ignorujte — vaše heslo nebylo "
"změněno."

#: mcprack/auth.py:640
msgid ""
"If that account exists and has an email on file, a reset link has been "
"sent."
msgstr ""
"Pokud tento účet existuje a má nastavený e-mail, byl odeslán odkaz pro "
"obnovení hesla."

#: mcprack/auth.py:653
msgid "This password reset link is invalid or has expired."
msgstr "Tento odkaz pro obnovení hesla je neplatný nebo vypršel."

#: mcprack/auth.py:671
msgid "Password reset. You can now log in."
msgstr "Heslo bylo obnoveno. Nyní se můžete přihlásit."

#: mcprack/catalog.py:476
msgid "Your access request was sent to the administrators."
msgstr "Vaše žádost o přístup byla odeslána administrátorům."

#: mcprack/reauth.py:159
msgid ""
"Please confirm your password to continue. Your changes were not saved - "
"submit them again afterwards."
msgstr ""
"Pro pokračování potvrďte prosím své heslo. Vaše změny nebyly uloženy – "
"odešlete je poté znovu."

#: mcprack/templates/_config_paths.html:4
#: mcprack/templates/_config_paths.html:27
#: mcprack/templates/_config_paths.html:40
#: mcprack/templates/_config_paths.html:55
msgid "Where to put this file"
msgstr "Kam tento soubor uložit"

#: mcprack/templates/_config_paths.html:6
msgid "Claude Desktop app — replace the whole file at:"
msgstr "Aplikace Claude Desktop — nahraďte celý soubor na:"

#: mcprack/templates/_config_paths.html:9
#: mcprack/templates/_config_paths.html:45
#: mcprack/templates/_config_paths.html:60
msgid "Linux"
msgstr "Linux"

#: mcprack/templates/_config_paths.html:10
#: mcprack/templates/_config_paths.html:46
#: mcprack/templates/_config_paths.html:61
msgid "macOS"
msgstr "macOS"

#: mcprack/templates/_config_paths.html:11
#: mcprack/templates/_config_paths.html:19
#: mcprack/templates/_config_paths.html:47
#: mcprack/templates/_config_paths.html:62
msgid "Windows"
msgstr "Windows"

#: mcprack/templates/_config_paths.html:15
msgid ""
"Claude Code (the CLI) — this file also holds other settings, so merge the"
" \"mcpServers\" key into it instead of overwriting it:"
msgstr ""
"Claude Code (CLI) — tento soubor obsahuje i další nastavení, proto do něj"
" klíč „mcpServers“ sloučte, místo abyste ho přepsali:"

#: mcprack/templates/_config_paths.html:18
msgid "Linux / macOS"
msgstr "Linux / macOS"

#: mcprack/templates/_config_paths.html:23
msgid ""
"Or install <code>mcprack-sync-claude</code> and run <code>mcprack-sync-"
"claude sync</code> to keep this file up to date automatically."
msgstr ""
"Nebo nainstalujte <code>mcprack-sync-claude</code> a spusťte <code"
">mcprack-sync-claude sync</code>, aby se soubor udržoval aktuální "
"automaticky."

#: mcprack/templates/_config_paths.html:29
msgid ""
"Claude Code, project scope — save it as .mcp.json in the root of the "
"project. The file contains no secret, so it can be committed; Claude Code"
" reads the token from the MCPRACK_TOKEN environment variable and asks for"
" approval before using a project-scoped server."
msgstr ""
"Claude Code, rozsah projektu — uložte jej jako .mcp.json do kořene "
"projektu. Soubor neobsahuje žádné tajemství, takže jej lze commitovat; "
"Claude Code načte token z proměnné prostředí MCPRACK_TOKEN a před "
"použitím serveru na úrovni projektu požádá o schválení."

#: mcprack/templates/_config_paths.html:32
msgid "Any OS"
msgstr "Libovolný OS"

#: mcprack/templates/_config_paths.html:36
msgid ""
"For all your projects use the claude mcp add commands on the View & Copy "
"page instead (user scope)."
msgstr ""
"Pro všechny své projekty použijte místo toho příkazy claude mcp add na "
"stránce Zobrazit a kopírovat (rozsah uživatele)."

#: mcprack/templates/_config_paths.html:42
msgid ""
"VS Code (user profile — applies to every workspace). If the file already "
"exists, merge the \"servers\" key into it instead of overwriting it:"
msgstr ""
"VS Code (uživatelský profil — platí pro všechny workspace). Pokud soubor "
"už existuje, sloučte do něj klíč „servers“, místo abyste ho přepsali:"

#: mcprack/templates/_config_paths.html:51
msgid ""
"Or install <code>mcprack-sync-vscode</code> and run <code>mcprack-sync-"
"vscode sync</code> to keep this file up to date automatically."
msgstr ""
"Nebo nainstalujte <code>mcprack-sync-vscode</code> a spusťte <code"
">mcprack-sync-vscode sync</code>, aby se soubor udržoval aktuální "
"automaticky."

#: mcprack/templates/_config_paths.html:57
msgid ""
"Cursor (user profile). If the file already exists, merge the "
"\"mcpServers\" key into it instead of overwriting it:"
msgstr ""
"Cursor (uživatelský profil). Pokud soubor už existuje, sloučte do něj "
"klíč „mcpServers“, místo abyste ho přepsali:"

#: mcprack/templates/_config_paths.html:63
msgid "Also checked"
msgstr "Kontroluje se také"

#: mcprack/templates/_config_paths.html:67
msgid ""
"Or install <code>mcprack-sync-cursor</code> and run <code>mcprack-sync-"
"cursor sync</code> to keep this file up to date automatically."
msgstr ""
"Nebo nainstalujte <code>mcprack-sync-cursor</code> a spusťte <code"
">mcprack-sync-cursor sync</code>, aby se soubor udržoval aktuální "
"automaticky."


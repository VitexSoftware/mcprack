#: mcprack/templates/admin/otel_wizard.html:5
msgid "Status of tracing/metrics export, and an on-demand test signal — see"
msgstr "Stav exportu trasování/metrik a testovací signál na vyžádání — viz"

#: mcprack/templates/admin/otel_wizard.html:6
msgid "README \"Observability\""
msgstr "README „Observabilita“"


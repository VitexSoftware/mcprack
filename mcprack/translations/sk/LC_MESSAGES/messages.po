#: mcprack/templates/_override_editor.html:13
msgid "Available configuration keys"
msgstr "Dostupné konfiguračné kľúče"

#: mcprack/templates/_override_editor.html:14
msgid "Click \"+ Add\" to override or prefill a key"
msgstr "Kliknutím na „+ Pridať“ kľúč prepíšete alebo predvyplníte"

#: mcprack/templates/_override_editor.html:24
msgid "Required variable"
msgstr "Povinná premenná"

#: mcprack/templates/_override_editor.html:24
#: mcprack/templates/admin/install_wizard.html:66
#: mcprack/templates/admin/install_wizard.html:103
#: mcprack/templates/admin/install_wizard.html:137
#: mcprack/templates/admin/server_form.html:50
#: mcprack/templates/server_page.html:124
msgid "required"
msgstr "povinné"

#: mcprack/templates/_override_editor.html:27
msgid "Sensitive value / secret"
msgstr "Citlivá hodnota / tajomstvo"

#: mcprack/templates/_override_editor.html:27
msgid "secret"
msgstr "tajné"

#: mcprack/templates/_override_editor.html:30
msgid "Configured by administrator"
msgstr "Nastavené správcom"

#: mcprack/templates/_override_editor.html:30
msgid "admin"
msgstr "admin"

#: mcprack/templates/_override_editor.html:38
msgid "Default:"
msgstr "Predvolené:"

#: mcprack/templates/_override_editor.html:42
msgid "Add"
msgstr "Pridať"

#: mcprack/templates/_override_editor.html:56
msgid "Add variable"
msgstr "Pridať premennú"

#: mcprack/templates/_override_editor.html:59
#: mcprack/templates/admin/server_form.html:57
msgid "Import .env file"
msgstr "Importovať súbor .env"

#: mcprack/templates/_override_editor.html:64
msgid "Empty rows inherit the administrator's default values."
msgstr "Prázdne riadky dedia predvolené hodnoty od administrátora."

#: mcprack/templates/_override_editor.html:80
#: mcprack/templates/admin/install_wizard.html:66
#: mcprack/templates/admin/install_wizard.html:103
#: mcprack/templates/admin/install_wizard.html:137
#: mcprack/templates/admin/server_form.html:50
msgid "sensitive"
msgstr "citlivé"

#: mcprack/templates/_override_editor.html:81
msgid ""
"Always stored as a secret — the administrator declared this key, or its name"
" looks like a credential."
msgstr ""
"Vždy sa ukladá ako tajná hodnota — tento kľúč deklaroval administrátor, "
"alebo jeho názov vyzerá ako prihlasovací údaj."

#: mcprack/templates/_override_editor.html:82
msgid "Inherited from admin"
msgstr "Zdedené od administrátora"

#: mcprack/templates/_override_editor.html:83
msgid "Overridden"
msgstr "Prepísané"

#: mcprack/templates/_override_editor.html:84
msgid "Custom"
msgstr "Vlastné"

#: mcprack/templates/_override_editor.html:85
msgid "↺ Revert to admin default"
msgstr "↺ Vrátiť na predvolené od administrátora"

#: mcprack/templates/_override_editor.html:86
msgid "Duplicate key — each variable name must be unique."
msgstr "Duplicitný kľúč — každý názov premennej musí byť jedinečný."

#: mcprack/templates/_override_editor.html:87
#: mcprack/templates/admin/install_wizard.html:66
#: mcprack/templates/admin/install_wizard.html:103
#: mcprack/templates/admin/install_wizard.html:137
#: mcprack/templates/admin/server_form.html:50
msgid "Key is required when a value is set."
msgstr "Keď je zadaná hodnota, kľúč je povinný."

#: mcprack/templates/_override_editor.html:88
#: mcprack/templates/admin/server_form.html:50
msgid "Required value missing — the server cannot start until this is filled in."
msgstr "Chýba povinná hodnota — bez jej vyplnenia server nenaštartuje."

#: mcprack/templates/_override_editor.html:89
#: mcprack/templates/admin/server_form.html:50
#, python-format
msgid ""
"%(n)s required value(s) missing — the MCP server will not start until they "
"are filled in."
msgstr ""
"Chýbajú povinné hodnoty (%(n)s) — kým ich nevyplníte, MCP server "
"nenaštartuje."

#: mcprack/templates/_override_editor.html:94
#: mcprack/templates/_override_editor.html:96
msgid "Advanced: Raw KEY=value text editor"
msgstr "Pokročilé: textový editor vo formáte KĽÚČ=hodnota"

#: mcprack/templates/_override_editor.html:97
msgid ""
"If this textarea is populated and no row inputs are submitted, these "
"KEY=value pairs will be saved."
msgstr ""
"Ak je toto pole vyplnené a neodošlú sa žiadne riadky editora, uložia sa "
"tieto páry KĽÚČ=hodnota."

#: mcprack/templates/_proxy_auth_note.html:6
msgid ""
"MCP OAuth is enabled: the aggregate URL is <code>/proxy/mcp/aggregate</code>"
" with no secret in the path. Your client will open a browser login the first"
" time it connects."
msgstr ""
"MCP OAuth je zapnuté: agregovaná URL je <code>/proxy/mcp/aggregate</code> "
"bez tajomstva v ceste. Klient pri prvom pripojení otvorí prihlásenie v "
"prehliadači."

#: mcprack/templates/_proxy_auth_note.html:9
msgid ""
"Signed path-token URLs still work if you need them (e.g. for <code>mcprack-"
"mcp-probe</code>)."
msgstr ""
"Podpísané URL s tokenom v ceste fungujú ďalej (napr. pre <code>mcprack-mcp-"
"probe</code>)."

#: mcprack/templates/_proxy_auth_note.html:15
msgid ""
"Each relay URL embeds a personal access token — treat a downloaded or copied"
" config like a password."
msgstr ""
"Každá relay URL obsahuje osobný prístupový token — stiahnutý alebo "
"skopírovaný config berte ako heslo."

#: mcprack/templates/account_mfa.html:12
msgid "Two-factor authentication is now on."
msgstr "Dvojfázové overenie je teraz zapnuté."

#: mcprack/templates/account_mfa.html:13
msgid "Your recovery codes"
msgstr "Vaše záložné kódy"

#: mcprack/templates/account_mfa.html:14
msgid ""
"Each code works once, if you lose your phone. They are shown only now — "
"store them somewhere safe (a password manager, a printout)."
msgstr ""
"Každý kód funguje len raz, pre prípad straty telefónu. Zobrazujú sa iba "
"teraz — uložte ich na bezpečné miesto (správca hesiel, výtlačok)."

#: mcprack/templates/account_mfa.html:17
msgid "I have saved them"
msgstr "Uložil/a som si ich"

#: mcprack/templates/account_mfa.html:22
msgid "Set up your authenticator app"
msgstr "Nastavte svoju autentifikačnú aplikáciu"

#: mcprack/templates/account_mfa.html:25
msgid ""
"In your authenticator app (FreeOTP, Aegis, Google Authenticator, …) choose "
"to add an account and scan this QR code."
msgstr ""
"V autentifikačnej aplikácii (FreeOTP, Aegis, Google Authenticator, …) zvoľte"
" pridanie účtu a naskenujte tento QR kód."

#: mcprack/templates/account_mfa.html:26 mcprack/templates/account_mfa.html:38
msgid "Enter the code the app shows to confirm."
msgstr "Na potvrdenie zadajte kód, ktorý aplikácia zobrazuje."


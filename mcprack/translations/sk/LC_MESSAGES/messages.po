#: mcprack/admin.py:218
msgid "This access request has already been resolved."
msgstr "Táto žiadosť o prístup už bola vybavená."

#: mcprack/admin.py:223
msgid "Enable the account and server before granting access."
msgstr "Pred udelením prístupu aktivujte účet a server."

#: mcprack/admin.py:245
msgid "Access request updated."
msgstr "Žiadosť o prístup bola aktualizovaná."

#: mcprack/app.py:247
msgid "Bad Request"
msgstr "Neplatná požiadavka"

#: mcprack/app.py:248
msgid "The request could not be understood by the server."
msgstr "Serveru sa nepodarilo požiadavke porozumieť."

#: mcprack/app.py:260
msgid "Access Denied"
msgstr "Prístup odmietnutý"

#: mcprack/app.py:261
msgid "You do not have permission to access this resource."
msgstr "K tomuto zdroju nemáte oprávnenie."

#: mcprack/app.py:273
msgid "Page Not Found"
msgstr "Stránka sa nenašla"

#: mcprack/app.py:274
msgid "The page or resource you requested could not be found."
msgstr "Požadovaná stránka ani zdroj sa nenašli."

#: mcprack/app.py:286
msgid "Request Too Large"
msgstr "Požiadavka je príliš veľká"

#: mcprack/app.py:287
msgid "The data you submitted is larger than this server accepts."
msgstr "Odoslané údaje sú väčšie, než tento server prijíma."

#: mcprack/app.py:300
msgid "Too Many Requests"
msgstr "Príliš veľa požiadaviek"

#: mcprack/app.py:301
msgid "Too many requests from your IP address. Please slow down and try again later."
msgstr ""
"Z vašej IP adresy prišlo príliš veľa požiadaviek. Spomaľte a skúste to znova"
" neskôr."

#: mcprack/app.py:315
msgid "Internal Server Error"
msgstr "Vnútorná chyba servera"

#: mcprack/app.py:316
msgid "An unexpected server error occurred. Please contact the administrator."
msgstr "Došlo k neočakávanej chybe servera. Obráťte sa na administrátora."

#: mcprack/app.py:328
msgid "Bad Gateway"
msgstr "Chybná brána"

#: mcprack/app.py:329
msgid "The upstream service did not respond properly."
msgstr "Nadradená služba neodpovedala správne."

#: mcprack/auth.py:148
msgid ""
"Administrators must set up two-factor authentication before using the admin "
"area."
msgstr "Správcovia musia pred použitím administrácie nastaviť dvojfázové overenie."

#: mcprack/auth.py:287
msgid "Your sign-in expired. Please enter your password again."
msgstr "Platnosť prihlásenia vypršala. Zadajte prosím znova svoje heslo."

#: mcprack/auth.py:295 mcprack/auth.py:338 mcprack/auth.py:515 mcprack/auth.py:548
#: mcprack/auth.py:584
msgid "Too many failed attempts. Try again in a few minutes."
msgstr "Príliš veľa neúspešných pokusov. Skúste to znova o niekoľko minút."

#: mcprack/auth.py:308
#, python-format
msgid ""
"You signed in with a recovery code. %(count)d left - consider generating new"
" ones."
msgstr ""
"Prihlásili ste sa záložným kódom. Zostáva ich %(count)d – zvážte vytvorenie "
"nových."

#: mcprack/auth.py:314
msgid "That code is not valid."
msgstr "Tento kód nie je platný."

#: mcprack/auth.py:354 mcprack/auth.py:384
msgid "Invalid username or password."
msgstr "Neplatné používateľské meno alebo heslo."

#: mcprack/auth.py:374
msgid "This account has been deactivated."
msgstr "Tento účet bol deaktivovaný."

#: mcprack/auth.py:437
msgid ""
"Your account is managed externally (LDAP) — its password can't be changed "
"here."
msgstr "Váš účet je spravovaný externe (LDAP) — jeho heslo tu nemožno zmeniť."

#: mcprack/auth.py:446
msgid "Current password is incorrect."
msgstr "Aktuálne heslo je nesprávne."

#: mcprack/auth.py:448 mcprack/auth.py:661
msgid "New password and confirmation don't match."
msgstr "Nové heslo a jeho potvrdenie sa nezhodujú."

#: mcprack/auth.py:458
msgid "Password changed."
msgstr "Heslo bolo zmenené."

#: mcprack/auth.py:478
msgid "QR code for your authenticator app"
msgstr "QR kód pre vašu autentifikačnú aplikáciu"

#: mcprack/auth.py:479
msgid "Scan it with an authenticator app to add this account."
msgstr "Naskenujte ho autentifikačnou aplikáciou a pridajte tento účet."

#: mcprack/auth.py:506
msgid ""
"Two-factor authentication is already on. Turn it off first to set it up "
"again."
msgstr ""
"Dvojfázové overenie je už zapnuté. Ak ho chcete nastaviť znova, najprv ho "
"vypnite."

#: mcprack/auth.py:519
msgid "Your password is not correct."
msgstr "Vaše heslo nie je správne."

#: mcprack/auth.py:529
msgid "That code is not valid. Check the time on your phone and try again."
msgstr "Tento kód nie je platný. Skontrolujte čas v telefóne a skúste to znova."

#: mcprack/auth.py:539
msgid "Two-factor authentication is not on."
msgstr "Dvojfázové overenie nie je zapnuté."

#: mcprack/auth.py:543
msgid "Administrators cannot turn two-factor authentication off."
msgstr "Správcovia nemôžu dvojfázové overenie vypnúť."

#: mcprack/auth.py:554 mcprack/auth.py:594
msgid "Your password or the code is not correct."
msgstr "Vaše heslo alebo kód nie je správny."

#: mcprack/auth.py:565
msgid "Two-factor authentication is now off."
msgstr "Dvojfázové overenie je teraz vypnuté."

#: mcprack/auth.py:568
msgid "Unknown action."
msgstr "Neznáma akcia."

#: mcprack/auth.py:626
msgid "mcprack password reset"
msgstr "Obnovenie hesla pre mcprack"

#: mcprack/auth.py:628
#, python-format
msgid ""
"Someone (hopefully you) requested a password reset for the mcprack account "
"'%(username)s'.\n"
"\n"
"Reset it here (valid for %(minutes)d minutes):\n"
"%(url)s\n"
"\n"
"If you didn't request this, ignore this email — your password hasn't been "
"changed."
msgstr ""
"Niekto (dúfajme, že vy) požiadal o obnovenie hesla pre účet mcprack "
"„%(username)s“.\n"
"\n"
"Obnovte ho tu (platí %(minutes)d minút):\n"
"%(url)s\n"
"\n"
"Ak ste o to nežiadali, tento e-mail ignorujte — vaše heslo nebolo zmenené."

#: mcprack/auth.py:640
msgid "If that account exists and has an email on file, a reset link has been sent."
msgstr ""
"Ak tento účet existuje a má nastavený e-mail, bol odoslaný odkaz na "
"obnovenie hesla."

#: mcprack/auth.py:653
msgid "This password reset link is invalid or has expired."
msgstr "Tento odkaz na obnovenie hesla je neplatný alebo vypršal."

#: mcprack/auth.py:671
msgid "Password reset. You can now log in."
msgstr "Heslo bolo obnovené. Teraz sa môžete prihlásiť."

#: mcprack/catalog.py:419
#, python-format
msgid "Subscribed to %(server)s."
msgstr "Odoberáte server %(server)s."

#: mcprack/catalog.py:423
#, python-format
msgid "Unsubscribed from %(server)s."
msgstr "Odber servera %(server)s bol zrušený."

#: mcprack/catalog.py:511
msgid "Your access request was sent to the administrators."
msgstr "Vaša žiadosť o prístup bola odoslaná administrátorom."

#: mcprack/reauth.py:164
msgid ""
"Please confirm your password to continue. Your changes were not saved - "
"submit them again afterwards."
msgstr ""
"Pre pokračovanie potvrďte prosím svoje heslo. Vaše zmeny neboli uložené – "
"odošlite ich potom znova."

#: mcprack/templates/_config_paths.html:4 mcprack/templates/_config_paths.html:27
#: mcprack/templates/_config_paths.html:40 mcprack/templates/_config_paths.html:55
msgid "Where to put this file"
msgstr "Kam tento súbor uložiť"

#: mcprack/templates/_config_paths.html:6
msgid "Claude Desktop app — replace the whole file at:"
msgstr "Aplikácia Claude Desktop — nahraďte celý súbor na:"

#: mcprack/templates/_config_paths.html:9 mcprack/templates/_config_paths.html:45
#: mcprack/templates/_config_paths.html:60
msgid "Linux"
msgstr "Linux"

#: mcprack/templates/_config_paths.html:10 mcprack/templates/_config_paths.html:46
#: mcprack/templates/_config_paths.html:61
msgid "macOS"
msgstr "macOS"

#: mcprack/templates/_config_paths.html:11 mcprack/templates/_config_paths.html:19
#: mcprack/templates/_config_paths.html:47 mcprack/templates/_config_paths.html:62
msgid "Windows"
msgstr "Windows"

#: mcprack/templates/_config_paths.html:15
msgid ""
"Claude Code (the CLI) — this file also holds other settings, so merge the "
"\"mcpServers\" key into it instead of overwriting it:"
msgstr ""
"Claude Code (CLI) — tento súbor obsahuje aj ďalšie nastavenia, preto doň "
"kľúč „mcpServers“ zlúčte, namiesto toho, aby ste ho prepísali:"

#: mcprack/templates/_config_paths.html:18
msgid "Linux / macOS"
msgstr "Linux / macOS"

#: mcprack/templates/_config_paths.html:23
msgid ""
"Or install <code>mcprack-sync-claude</code> and run <code>mcprack-sync-"
"claude sync</code> to keep this file up to date automatically."
msgstr ""
"Alebo nainštalujte <code>mcprack-sync-claude</code> a spustite <code"
">mcprack-sync-claude sync</code>, aby sa súbor udržiaval aktuálny "
"automaticky."

#: mcprack/templates/_config_paths.html:29
msgid ""
"Claude Code, project scope — save it as .mcp.json in the root of the "
"project. The file contains no secret, so it can be committed; Claude Code "
"reads the token from the MCPRACK_TOKEN environment variable and asks for "
"approval before using a project-scoped server."
msgstr ""
"Claude Code, rozsah projektu — uložte ho ako .mcp.json do koreňa projektu. "
"Súbor neobsahuje žiadne tajomstvo, takže ho možno commitnúť; Claude Code "
"načíta token z premennej prostredia MCPRACK_TOKEN a pred použitím servera na"
" úrovni projektu požiada o schválenie."

#: mcprack/templates/_config_paths.html:32
msgid "Any OS"
msgstr "Ľubovoľný OS"

#: mcprack/templates/_config_paths.html:36
msgid ""
"For all your projects use the claude mcp add commands on the View & Copy "
"page instead (user scope)."
msgstr ""
"Pre všetky svoje projekty použite namiesto toho príkazy claude mcp add na "
"stránke Zobraziť a kopírovať (rozsah používateľa)."

#: mcprack/templates/_config_paths.html:42
msgid ""
"VS Code (user profile — applies to every workspace). If the file already "
"exists, merge the \"servers\" key into it instead of overwriting it:"
msgstr ""
"VS Code (užívateľský profil — platí pre všetky workspace). Ak súbor už "
"existuje, zlúčte doň kľúč „servers“, namiesto toho, aby ste ho prepísali:"

#: mcprack/templates/_config_paths.html:51
msgid ""
"Or install <code>mcprack-sync-vscode</code> and run <code>mcprack-sync-"
"vscode sync</code> to keep this file up to date automatically."
msgstr ""
"Alebo nainštalujte <code>mcprack-sync-vscode</code> a spustite <code"
">mcprack-sync-vscode sync</code>, aby sa súbor udržiaval aktuálny "
"automaticky."

#: mcprack/templates/_config_paths.html:57
msgid ""
"Cursor (user profile). If the file already exists, merge the \"mcpServers\" "
"key into it instead of overwriting it:"
msgstr ""
"Cursor (užívateľský profil). Ak súbor už existuje, zlúčte doň kľúč "
"„mcpServers“, namiesto toho, aby ste ho prepísali:"

#: mcprack/templates/_config_paths.html:63
msgid "Also checked"
msgstr "Kontroluje sa aj"

#: mcprack/templates/_config_paths.html:67
msgid ""
"Or install <code>mcprack-sync-cursor</code> and run <code>mcprack-sync-"
"cursor sync</code> to keep this file up to date automatically."
msgstr ""
"Alebo nainštalujte <code>mcprack-sync-cursor</code> a spustite <code"
">mcprack-sync-cursor sync</code>, aby sa súbor udržiaval aktuálny "
"automaticky."


FROM vitexsoftware/debian:trixie

ENV MOZ_HEADLESS=1 \
    DEBIAN_FRONTEND=noninteractive

# The base image's dpkg config excludes /usr/share/locale/* to save space,
# which silently strips mcprack's own cs/sk .mo translation catalogs on
# install (session-based locale switching then has nothing to load - the
# locale cookie gets set but the UI text never changes). Drop that exclusion
# rule before installing so mcprack's translations actually land on disk.
RUN sed -i '\#path-exclude /usr/share/locale/\*#d' /etc/dpkg/dpkg.cfg.d/docker

# Tolerate a missing/403 vitexsoftware backports index so main packages
# still install from a warm buildkit cache or a partial apt update.
RUN apt-get update || true \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        adduser \
        mcprack \
        python3-pymysql \
        abraflexi-mcp-server \
        mastodon-mcp-server \
        mcp-email-server \
        mcp-server-datovka \
        mcp-server-filesystem \
        multiflexi-mcp-server \
        netbox-mcp-server \
        redmine-mcp-server \
        semaphore-mcp-server \
        zabbix-mcp-server \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update || true \
    && apt-get install -y --no-install-recommends \
        mcp-server-webdriver \
        firefox-esr \
        linkedin-mcp-server \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Overlay the full application tree from the repository build context
# (see Makefile). Must stay in sync: copying only templates/static onto an
# older apt package leaves url_for targets that the installed code lacks
# (500 on every page that extends base.html with admin menu links).
COPY mcprack/ /usr/lib/mcprack/mcprack/

EXPOSE 8913

ENTRYPOINT ["gunicorn", \
    "--bind", "127.0.0.1:8913", \
    "--workers", "4", \
    "--worker-class", "sync", \
    "--worker-tmp-dir", "/dev/shm", \
    "--timeout", "30", \
    "--chdir", "/usr/lib/mcprack", \
    "wsgi:application"]

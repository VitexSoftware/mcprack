#!/usr/bin/env python3
"""
mcprack-mcp-manager: Generates MCP server wrapper scripts and FastMCP config
from database entries with environment variables.

Usage:
    mcprack-mcp-manager [--db-path=/path/to/mcprack.db] [--output-dir=/etc/mcprack] [--restart-proxy]
"""

import json
import os
import subprocess
import sys
from pathlib import Path
import sqlite3
import argparse

def get_servers(db_path):
    """Fetch all MCP servers from database with their environment configs."""
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT id, name, transport, command, args_json, env_config_json, enabled
        FROM mcp_servers
        WHERE enabled = 1
    """)
    
    servers = []
    for row in cursor.fetchall():
        env_config = {}
        if row['env_config_json']:
            try:
                env_config = json.loads(row['env_config_json'])
            except json.JSONDecodeError:
                pass
        
        servers.append({
            'id': row['id'],
            'name': row['name'],
            'transport': row['transport'],
            'command': row['command'],
            'args': json.loads(row['args_json']) if row['args_json'] else [],
            'env_config': env_config,
        })
    
    conn.close()
    return servers

def create_env_wrapper(server, output_dir):
    """Create wrapper script that sources environment variables before running server."""
    if not server['command']:
        return None
    
    wrapper_path = Path(output_dir) / f"{server['name']}-env-wrapper.sh"
    env_file = Path(output_dir) / f"{server['name']}.env"
    
    # Write environment variables to .env file
    with open(env_file, 'w') as f:
        f.write(f"# Environment variables for {server['name']}\n")
        for key, value in server['env_config'].items():
            f.write(f"{key}={value}\n")
        f.write(f"# Auto-generated by mcprack-mcp-manager\n")
    
    env_file.chmod(0o600)  # Restrict permissions for sensitive data
    
    # Write wrapper script
    wrapper_script = f"""#!/bin/bash
# Wrapper for {server['name']} - sources environment variables before execution
# Auto-generated by mcprack-mcp-manager

set -e

# Source environment file
if [ -f "{env_file}" ]; then
    source "{env_file}"
fi

# Execute the actual server binary
exec {server['command']} "$@"
"""
    
    with open(wrapper_path, 'w') as f:
        f.write(wrapper_script)
    
    wrapper_path.chmod(0o755)
    return str(wrapper_path)

def generate_fastmcp_config(servers, output_dir):
    """Generate FastMCP proxy configuration from server list."""
    config = {"mcpServers": {}}
    
    for server in servers:
        if server['transport'] != 'stdio':
            continue
        
        # Use wrapper script if environment variables are configured, otherwise use direct command
        command = server['command']
        if server['env_config'] and server['command']:
            wrapper_path = create_env_wrapper(server, output_dir)
            if wrapper_path:
                command = wrapper_path
        
        config['mcpServers'][server['name']] = {
            'type': 'stdio',
            'command': command,
            'args': server['args']
        }
    
    return config

def main():
    parser = argparse.ArgumentParser(description='Generate MCP server configuration from database')
    parser.add_argument('--db-path', default='/var/lib/mcprack/mcprack.db', help='Path to mcprack database')
    parser.add_argument('--output-dir', default='/etc/mcprack', help='Output directory for wrapper scripts')
    parser.add_argument('--config-output', default='/var/lib/mcprack/proxy-mcp.json', help='Output path for FastMCP config')
    parser.add_argument('--restart-proxy', action='store_true', help='Restart mcprack-proxy service after update')
    args = parser.parse_args()
    
    # Ensure output directory exists
    Path(args.output_dir).mkdir(parents=True, exist_ok=True)
    
    # Get servers from database
    try:
        servers = get_servers(args.db_path)
        print(f"✓ Found {len(servers)} enabled MCP servers", file=sys.stderr)
    except Exception as e:
        print(f"✗ Error reading database: {e}", file=sys.stderr)
        return 1
    
    # Generate FastMCP configuration
    try:
        config = generate_fastmcp_config(servers, args.output_dir)
        with open(args.config_output, 'w') as f:
            json.dump(config, f, indent=2)
        print(f"✓ Generated FastMCP config: {args.config_output}", file=sys.stderr)
    except Exception as e:
        print(f"✗ Error generating config: {e}", file=sys.stderr)
        return 1
    
    # Restart proxy if requested
    if args.restart_proxy:
        try:
            subprocess.run(['sudo', 'systemctl', 'restart', 'mcprack-proxy.service'], check=True)
            print("✓ FastMCP proxy restarted", file=sys.stderr)
        except Exception as e:
            print(f"✗ Error restarting proxy: {e}", file=sys.stderr)
            return 1
    
    # Output config to stdout for verification
    print(json.dumps(config, indent=2))
    return 0

if __name__ == '__main__':
    sys.exit(main())

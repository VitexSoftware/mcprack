#!/bin/bash
# MCprack configuration initialization script
# Ensures /etc/mcprack/env is properly configured for production use
# 
# Usage: mcprack-init-config [--force]
#   --force: Regenerate SECRET_KEY even if it already exists

set -e

CONFIG_FILE="/etc/mcprack/env"
FORCE=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --force) FORCE=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}MCprack Configuration Initialization${NC}"
echo "========================================"

# Check if running as root or with sudo
if [[ $EUID -ne 0 ]]; then
  echo -e "${RED}❌ This script must be run as root (use sudo)${NC}"
  exit 1
fi

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
  echo -e "${RED}❌ Configuration file not found: $CONFIG_FILE${NC}"
  echo "Run the package installation first: apt install mcprack"
  exit 1
fi

# Check if SECRET_KEY is already set and valid
HAS_SECRET_KEY=false
if grep -q "^SECRET_KEY=" "$CONFIG_FILE" 2>/dev/null; then
  SECRET_KEY_VALUE=$(grep "^SECRET_KEY=" "$CONFIG_FILE" | cut -d= -f2- | tr -d "'\""  )
  if [ -n "$SECRET_KEY_VALUE" ] && [ "$SECRET_KEY_VALUE" != "dev-insecure-secret-change-me" ]; then
    HAS_SECRET_KEY=true
  fi
fi

if [ "$HAS_SECRET_KEY" = true ] && [ "$FORCE" = false ]; then
  echo -e "${GREEN}✅ SECRET_KEY is already configured${NC}"
  echo "   Run with --force to regenerate"
else
  if [ "$FORCE" = true ] && [ "$HAS_SECRET_KEY" = true ]; then
    echo -e "${YELLOW}⚠️  Regenerating SECRET_KEY (as requested with --force)${NC}"
  else
    echo -e "${YELLOW}⚠️  SECRET_KEY is not properly configured${NC}"
  fi
  
  # Generate a new SECRET_KEY
  NEW_SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(32))" 2>/dev/null || python3 -c "import random; import string; print(''.join(random.choices(string.ascii_letters + string.digits, k=40)))")
  
  # Remove old SECRET_KEY line if it exists
  if grep -q "^SECRET_KEY=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i "/^SECRET_KEY=/d" "$CONFIG_FILE"
  fi
  
  # Add new SECRET_KEY
  echo "SECRET_KEY=$NEW_SECRET_KEY" >> "$CONFIG_FILE"
  
  echo -e "${GREEN}✅ SECRET_KEY generated and saved to $CONFIG_FILE${NC}"
fi

# Verify file permissions
PERMS=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || stat -f '%A' "$CONFIG_FILE" 2>/dev/null)
if [ "$PERMS" != "640" ] && [ "$PERMS" != "600" ]; then
  echo -e "${YELLOW}⚠️  Fixing file permissions...${NC}"
  chmod 0640 "$CONFIG_FILE"
  chown root:mcprack "$CONFIG_FILE"
fi

# Check that config file is readable by mcprack user
if ! su -s /bin/sh mcprack -c "test -r $CONFIG_FILE" 2>/dev/null; then
  echo -e "${RED}❌ mcprack user cannot read config file${NC}"
  echo "   Run: chmod 0640 $CONFIG_FILE && chown root:mcprack $CONFIG_FILE"
  exit 1
fi

echo -e "${GREEN}========================================"
echo "Configuration check complete!"
echo "${NC}"

# Try to restart the service if it exists
if systemctl list-unit-files mcprack.service &>/dev/null; then
  echo -e "${YELLOW}Attempting to restart mcprack service...${NC}"
  if systemctl restart mcprack 2>/dev/null; then
    echo -e "${GREEN}✅ mcprack service restarted successfully${NC}"
    sleep 2
    if systemctl is-active --quiet mcprack; then
      echo -e "${GREEN}✅ mcprack service is running${NC}"
      echo ""
      systemctl status mcprack --no-pager | head -10
    else
      echo -e "${RED}❌ mcprack service failed to start${NC}"
      echo "   Check logs: journalctl -u mcprack -n 50"
      exit 1
    fi
  else
    echo -e "${YELLOW}ℹ️  Could not restart service (no sudo or service not ready)${NC}"
    echo "   Run manually: sudo systemctl restart mcprack"
  fi
fi

echo -e "${GREEN}${NC}"
echo "Next steps:"
echo "  1. Verify service is running: systemctl status mcprack"
echo "  2. Check logs: journalctl -u mcprack -f"
echo "  3. Access the web UI: https://mcprack.mojavoda.sk"
